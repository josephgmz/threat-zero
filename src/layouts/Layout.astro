---
// src/layouts/BaseLayout.astro
interface Props {
  title?: string;
}

const { title = "Mi Proyecto Astro" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* Definición del degradado personalizado basado en la imagen */
      .banner-gradient {
        background-image: linear-gradient(
          to right,
          #07f48a 0%,    /* Verde esmeralda de la izquierda */
          #14f2bc 40%,   /* Tono verde menta intermedio */
          #74f8fd 100%    /* Cian suave de la derecha */
        );
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col antialiased">
    <header class="w-full bg-zinc-900 border-b border-zinc-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
        <div class="banner-gradient rounded-xl shadow-lg relative h-40 overflow-hidden flex items-center px-10">
          <h1 class="text-4xl font-bold text-zinc-950 tracking-tight drop-shadow-sm">Mi Menú</h1>
          
          <nav class="hidden md:flex ml-16 space-x-6">
            <a href="#" class="text-lg font-medium text-zinc-900 hover:text-zinc-950 transition">Inicio</a>
            <a href="#" class="text-lg font-medium text-zinc-900 hover:text-zinc-950 transition">Proyectos</a>
            <a href="#" class="text-lg font-medium text-zinc-900 hover:text-zinc-950 transition">Sobre Mí</a>
          </nav>

          <div class="absolute bottom-[-32px] right-[-32px]">
            <div class="w-32 h-32 rounded-full bg-zinc-200 border-8 border-zinc-900 flex items-center justify-center shadow-xl">
              <span class="text-3xl font-mono text-zinc-500">?</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
      <slot />
    </main>

    <footer class="w-full bg-zinc-900 mt-12 border-t border-zinc-800 p-8 text-center text-zinc-500">
      &copy; 2023 Mi Proyecto Astro. Todos los derechos reservados.
    </footer>
  </body>
</html>