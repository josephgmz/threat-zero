---
// src/layouts/BaseLayout.astro
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Ciberseguridad Corporativa</title>
    <style is:global>
        :root {
            /* Banner superior */
            --gradient-start: #00E676; 
            --gradient-end: #00E0D2;
            --main-gradient: linear-gradient(to right, var(--gradient-start), var(--gradient-end));
            
            /* Círculo flotante */
            --circle-color: #E0E0E0; 
            
            /* Colores adaptados para fondo oscuro */
            --text-primary: #F5F5F7; 
            --text-secondary: #A1A1AA; 
            --surface-color: #1E1E1E; 
            --accent-color: #00E0D2; 
        }

        /* CORRECCIÓN: Aplicamos el fondo a html y body juntos */
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            
            /* Degradado oscuro directamente aplicado */
            background-color: #151515; /* Color de respaldo */
            background-image: linear-gradient(to bottom, #151515, #2a2a2a);
            background-attachment: fixed;
            
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh; /* Asegura que cubra toda la pantalla */
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Cabecera Banner */
        .banner {
            background: var(--main-gradient);
            height: 180px; 
            position: relative; 
            overflow: hidden; 
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .banner-content {
            z-index: 2; 
            text-align: center;
        }

        .banner-content h1 {
            color: #121212; 
            margin: 0;
            font-size: 2.5rem;
            font-weight: 800;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header class="banner">
        <div class="banner-content">
            <h1>Formulario de Ciberseguridad</h1>
        </div>
        <div class="banner-circle"></div>
    </header>
    
    <main class="container">
        <slot />
    </main>

    <footer>
        <p>&copy; 2026 [Nombre de tu Organización]. Todos los derechos reservados.</p>
    </footer>
</body>
</html>