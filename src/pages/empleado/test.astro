---
// src/pages/empleado/test.astro
// Test de ciberseguridad — Threat Zero
export const prerender = false;

import mysql from 'mysql2/promise';

// Verificar sesión de empleado
const session = Astro.cookies.get('empleado_session');
if (!session?.value) return Astro.redirect('/empleado/auth');

interface Pregunta {
  id_pregunta: number;
  pregunta: string;
  respuestas: { id_respuesta: number; respuesta: string }[];
}

let empleado: { id_usuario: number; nombre: string } | null = null;
let preguntas: Pregunta[] = [];
let yaHizoTest = false;

try {
  const sesion = JSON.parse(session.value);
  const conn = await mysql.createConnection({
    host:     import.meta.env.DB_HOST     || 'localhost',
    user:     import.meta.env.DB_USER     || 'root',
    password: import.meta.env.DB_PASSWORD || '',
    database: import.meta.env.DB_NAME     || 'threat_zero',
  });

  // Verificar si ya hizo el test
  const [diagRows] = await conn.execute<any[]>(
    'SELECT id_diagnostico FROM diagnostico WHERE id_usuario = ? LIMIT 1',
    [sesion.id_usuario]
  );
  yaHizoTest = diagRows.length > 0;

  if (!yaHizoTest) {
    // Cargar preguntas con sus respuestas
    const [pregRows] = await conn.execute<any[]>(
      'SELECT id_pregunta, pregunta FROM preguntas ORDER BY id_pregunta'
    );
    const [respRows] = await conn.execute<any[]>(
      'SELECT id_respuesta, respuesta, id_pregunta FROM respuestas ORDER BY id_pregunta, RAND()'
    );

    preguntas = pregRows.map((p: any) => ({
      id_pregunta: p.id_pregunta,
      pregunta:    p.pregunta,
      respuestas:  respRows
        .filter((r: any) => r.id_pregunta === p.id_pregunta)
        .map((r: any) => ({ id_respuesta: r.id_respuesta, respuesta: r.respuesta })),
    }));
  }

  empleado = { id_usuario: sesion.id_usuario, nombre: sesion.nombre };
  await conn.end();
} catch (e) {
  console.error('[test]', e);
}

if (!empleado) return Astro.redirect('/empleado/auth');

// Pasar preguntas al cliente de forma segura (sin es_correcta)
const preguntasJSON = JSON.stringify(preguntas);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Threat Zero — Test de Ciberseguridad</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg-base:      #0a0b0d;
      --bg-surface:   #0f1114;
      --bg-card:      #13161a;
      --border:       #1e2329;
      --accent:       #00e5a0;
      --accent-dim:   #00c98a;
      --accent-faint: #00e5a010;
      --accent-glow:  #00e5a035;
      --danger:       #ff4d6a;
      --warning:      #ffb347;
      --text-primary: #eef0f3;
      --text-secondary:#8a9099;
      --text-muted:   #4a5260;
      --font-display: 'Outfit', sans-serif;
      --font-mono:    'Space Mono', monospace;
      --font-body:    'DM Sans', sans-serif;
      --radius-sm: 6px; --radius-md: 12px; --radius-lg: 20px;
    }

    html, body { min-height: 100%; background: var(--bg-base); color: var(--text-primary); font-family: var(--font-body); }

    /* Grid fondo */
    body::before {
      content: ''; position: fixed; inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black, transparent);
      opacity: 0.25; pointer-events: none; z-index: 0;
    }

    /* ── NAV ── */
    nav {
      position: relative; z-index: 10;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1.5rem, 4vw, 3rem); height: 64px;
      background: rgba(10,11,13,0.9); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }

    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .logo-icon { width: 32px; height: 32px; background: var(--accent); border-radius: 7px; display: grid; place-items: center; }
    .logo-icon svg { width: 18px; height: 18px; fill: var(--bg-base); }
    .logo-text { font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; }
    .logo-text span { color: var(--accent); }
    .nav-user { font-size: 0.82rem; color: var(--text-secondary); }
    .nav-user strong { color: var(--text-primary); }

    /* ── YA HIZO EL TEST ── */
    .already-done {
      position: relative; z-index: 1;
      max-width: 520px; margin: 6rem auto;
      text-align: center; padding: 0 1.5rem;
      animation: fade-up 0.5s ease both;
    }

    .done-icon { font-size: 3.5rem; margin-bottom: 1rem; }

    .already-done h2 {
      font-family: var(--font-display); font-size: 1.6rem;
      font-weight: 800; margin-bottom: 0.75rem;
    }

    .already-done p { color: var(--text-secondary); margin-bottom: 2rem; line-height: 1.65; }

    .btn-back {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--accent); color: var(--bg-base);
      border: none; border-radius: var(--radius-sm);
      padding: 0.75rem 1.5rem; font-family: var(--font-display);
      font-size: 0.9rem; font-weight: 700; cursor: pointer;
      text-decoration: none; transition: all 0.2s;
    }

    .btn-back:hover { background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-glow); }

    /* ── WRAPPER DEL TEST ── */
    .test-wrapper {
      position: relative; z-index: 1;
      max-width: 680px; margin: 0 auto;
      padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2rem);
    }

    /* ── PROGRESS ── */
    .progress-header {
      margin-bottom: 2.5rem;
      animation: fade-up 0.4s ease both;
    }

    .progress-meta {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .progress-label {
      font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--text-muted); letter-spacing: 0.1em; text-transform: uppercase;
    }

    .progress-count {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent);
    }

    .progress-bar {
      height: 4px; background: var(--border);
      border-radius: 2px; overflow: hidden;
    }

    .progress-fill {
      height: 100%; background: var(--accent);
      border-radius: 2px; transition: width 0.4s ease;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    /* ── CARD PREGUNTA ── */
    .question-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden;
      animation: fade-up 0.4s ease both;
    }

    .question-card::before {
      content: ''; display: block; height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent-dim));
    }

    .question-body { padding: 2rem 2rem 1.5rem; }

    .question-category {
      font-family: var(--font-mono); font-size: 0.65rem;
      color: var(--accent); letter-spacing: 0.1em;
      text-transform: uppercase; margin-bottom: 1rem;
      display: flex; align-items: center; gap: 6px;
    }

    .question-category::before {
      content: ''; width: 6px; height: 6px;
      background: var(--accent); border-radius: 50%;
      box-shadow: 0 0 6px var(--accent);
    }

    .question-text {
      font-family: var(--font-display); font-size: clamp(1.1rem, 2.5vw, 1.3rem);
      font-weight: 700; line-height: 1.35; letter-spacing: -0.01em;
      margin-bottom: 2rem;
    }

    /* Opciones */
    .options-grid {
      display: flex; flex-direction: column; gap: 0.65rem;
    }

    .option-btn {
      width: 100%; text-align: left;
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: 1rem 1.1rem;
      display: flex; align-items: center; gap: 1rem;
      cursor: pointer; transition: all 0.18s; color: var(--text-primary);
      font-family: var(--font-body); font-size: 0.9rem; line-height: 1.4;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--accent-glow);
      background: var(--accent-faint);
    }

    .option-btn.selected {
      border-color: var(--accent);
      background: var(--accent-faint);
      box-shadow: 0 0 0 1px var(--accent-glow);
    }

    .option-btn.correct {
      border-color: var(--accent);
      background: var(--accent-faint);
      color: var(--accent);
    }

    .option-btn.wrong {
      border-color: var(--danger);
      background: rgba(255,77,106,0.08);
      color: var(--danger);
    }

    .option-btn:disabled { cursor: default; }

    .option-letter {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--bg-card); border: 1px solid var(--border);
      display: grid; place-items: center; flex-shrink: 0;
      font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--text-muted); transition: all 0.18s;
    }

    .option-btn.selected .option-letter {
      background: var(--accent); border-color: var(--accent);
      color: var(--bg-base); font-weight: 700;
    }

    .option-btn.correct .option-letter {
      background: var(--accent); border-color: var(--accent); color: var(--bg-base);
    }

    .option-btn.wrong .option-letter {
      background: var(--danger); border-color: var(--danger); color: white;
    }

    /* Feedback inline */
    .feedback-msg {
      display: none; align-items: flex-start; gap: 0.75rem;
      margin: 1.25rem 0 0; padding: 0.85rem 1rem;
      border-radius: var(--radius-sm); font-size: 0.85rem; line-height: 1.55;
    }

    .feedback-msg.show { display: flex; }
    .feedback-msg.correct-fb { background: var(--accent-faint); border: 1px solid var(--accent-glow); color: var(--accent); }
    .feedback-msg.wrong-fb   { background: rgba(255,77,106,0.08); border: 1px solid rgba(255,77,106,0.3); color: #ff8099; }

    .feedback-msg svg {
      width: 16px; height: 16px; stroke: currentColor;
      fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
      flex-shrink: 0; margin-top: 1px;
    }

    /* ── FOOTER DE LA CARD ── */
    .question-footer {
      padding: 1.25rem 2rem; border-top: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }

    .btn-nav {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 0.65rem 1.25rem; border-radius: var(--radius-sm);
      font-family: var(--font-display); font-size: 0.875rem; font-weight: 700;
      cursor: pointer; transition: all 0.2s; border: none;
    }

    .btn-nav svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .btn-prev {
      background: transparent; border: 1px solid var(--border) !important;
      color: var(--text-secondary);
    }
    .btn-prev:hover { border-color: var(--accent) !important; color: var(--accent); }
    .btn-prev:disabled { opacity: 0.3; cursor: not-allowed; }

    .btn-next {
      background: var(--accent); color: var(--bg-base);
    }
    .btn-next:hover:not(:disabled) { background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-glow); }
    .btn-next:disabled { opacity: 0.4; cursor: not-allowed; }

    .btn-submit-test {
      background: var(--accent); color: var(--bg-base);
      display: none;
    }
    .btn-submit-test:hover:not(:disabled) { background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-glow); }
    .btn-submit-test:disabled { opacity: 0.5; cursor: not-allowed; }

    .answers-hint {
      font-size: 0.75rem; color: var(--text-muted);
      font-family: var(--font-mono);
    }

    /* ── PANTALLA DE RESULTADOS ── */
    .results-screen {
      display: none;
      animation: fade-up 0.5s ease both;
    }

    .results-screen.show { display: block; }
    .question-card.hide  { display: none; }

    .result-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden; text-align: center;
    }

    .result-card::before {
      content: ''; display: block; height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent-dim));
    }

    .result-body { padding: 2.5rem 2rem; }

    .result-score-wrap {
      position: relative; width: 140px; height: 140px;
      margin: 0 auto 1.5rem;
    }

    .result-score-wrap svg { transform: rotate(-90deg); }
    .ring-bg   { fill: none; stroke: var(--border); stroke-width: 10; }
    .ring-fill {
      fill: none; stroke-width: 10; stroke-linecap: round;
      stroke-dasharray: 376;
      transition: stroke-dashoffset 1.2s ease, stroke 0.5s;
    }

    .score-center {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
    }

    .score-num {
      font-family: var(--font-display); font-size: 2.2rem;
      font-weight: 800; line-height: 1;
    }

    .score-lbl { font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-muted); }

    .result-nivel {
      font-family: var(--font-display); font-size: 1.4rem;
      font-weight: 800; margin-bottom: 0.5rem;
    }

    .result-desc { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; max-width: 420px; margin: 0 auto 2rem; }

    .result-stats {
      display: flex; justify-content: center; gap: 2rem;
      margin-bottom: 2rem; flex-wrap: wrap;
    }

    .rstat { text-align: center; }
    .rstat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; }
    .rstat-lbl { font-size: 0.75rem; color: var(--text-muted); }

    .btn-finish {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--accent); color: var(--bg-base);
      border: none; border-radius: var(--radius-sm);
      padding: 0.8rem 1.75rem; font-family: var(--font-display);
      font-size: 0.95rem; font-weight: 700; cursor: pointer;
      text-decoration: none; transition: all 0.2s;
    }

    .btn-finish:hover { background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-glow); }

    /* Spinner de envío */
    .sending-overlay {
      display: none; position: fixed; inset: 0; z-index: 100;
      background: rgba(10,11,13,0.85); backdrop-filter: blur(8px);
      flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
    }

    .sending-overlay.show { display: flex; }

    .send-spinner {
      width: 40px; height: 40px;
      border: 3px solid var(--border); border-top-color: var(--accent);
      border-radius: 50%; animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .send-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); }

    @keyframes fade-up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:none} }

    @media (max-width: 600px) {
      .question-body { padding: 1.5rem; }
      .question-footer { padding: 1rem 1.5rem; flex-wrap: wrap; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.25C17.25 22.15 21 17.25 21 12V7L12 2z"/></svg>
      </div>
      <span class="logo-text">Threat<span>Zero</span></span>
    </a>
    <span class="nav-user">Test de <strong>{empleado.nombre.split(' ')[0]}</strong></span>
  </nav>

  {yaHizoTest ? (
    <!-- Ya completó el test -->
    <div class="already-done">
      <div class="done-icon">✅</div>
      <h2>Ya completaste el test</h2>
      <p>Tu diagnóstico ya fue registrado y enviado a tu empresa. Solo se puede realizar una vez.</p>
      <a href="/empleado/bienvenida" class="btn-back">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Volver a mi portal
      </a>
    </div>
  ) : (
    <div class="test-wrapper">

      <!-- PROGRESO -->
      <div class="progress-header">
        <div class="progress-meta">
          <span class="progress-label">Test de ciberseguridad</span>
          <span class="progress-count" id="progress-count">1 / {preguntas.length}</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
        </div>
      </div>

      <!-- CARD PREGUNTA -->
      <div class="question-card" id="question-card">
        <div class="question-body">
          <div class="question-category">Pregunta activa</div>
          <p class="question-text" id="question-text">Cargando...</p>

          <div class="options-grid" id="options-grid"></div>

          <div class="feedback-msg" id="feedback-msg">
            <svg id="feedback-icon" viewBox="0 0 24 24"></svg>
            <span id="feedback-text"></span>
          </div>
        </div>

        <div class="question-footer">
          <button class="btn-nav btn-prev" id="btn-prev" disabled>
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Anterior
          </button>
          <span class="answers-hint" id="answers-hint">Selecciona una opción</span>
          <button class="btn-nav btn-next" id="btn-next" disabled>
            Siguiente
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button class="btn-nav btn-submit-test" id="btn-submit-test" disabled>
            Enviar test
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>
      </div>

      <!-- RESULTADOS -->
      <div class="results-screen" id="results-screen">
        <div class="result-card">
          <div class="result-body">
            <div class="result-score-wrap">
              <svg width="140" height="140" viewBox="0 0 140 140">
                <circle class="ring-bg"   cx="70" cy="70" r="60"/>
                <circle class="ring-fill" cx="70" cy="70" r="60" id="ring-fill" stroke="var(--accent)" stroke-dashoffset="376"/>
              </svg>
              <div class="score-center">
                <span class="score-num" id="res-score">0</span>
                <span class="score-lbl">PUNTAJE</span>
              </div>
            </div>

            <div class="result-nivel" id="res-nivel">—</div>
            <p class="result-desc" id="res-desc">Calculando tu diagnóstico...</p>

            <div class="result-stats">
              <div class="rstat">
                <div class="rstat-val" style="color:var(--accent)" id="res-correctas">0</div>
                <div class="rstat-lbl">Correctas</div>
              </div>
              <div class="rstat">
                <div class="rstat-val" style="color:var(--danger)" id="res-incorrectas">0</div>
                <div class="rstat-lbl">Incorrectas</div>
              </div>
              <div class="rstat">
                <div class="rstat-val" id="res-total">0</div>
                <div class="rstat-lbl">Total preguntas</div>
              </div>
            </div>

            <a href="/empleado/bienvenida" class="btn-finish" id="btn-finish">
              Ver mi portal
              <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  )}

  <!-- Overlay de envío -->
  <div class="sending-overlay" id="sending-overlay">
    <div class="send-spinner"></div>
    <span class="send-label">Registrando tu diagnóstico...</span>
  </div>

  <script define:vars={{ preguntasJSON, idUsuario: empleado.id_usuario }}>
    // @ts-nocheck
    const PREGUNTAS = JSON.parse(preguntasJSON);
    if (!PREGUNTAS || PREGUNTAS.length === 0) {
      document.querySelector('.test-wrapper').innerHTML =
        '<p style="text-align:center;color:var(--text-muted);padding:4rem">No hay preguntas disponibles aún.</p>';
    } else {
      initTest();
    }

    function initTest() {
      let current    = 0;
      let respuestas = {}; // { id_pregunta: id_respuesta }
      let respondida = {}; // { id_pregunta: { correcta: bool, id_correcta: number } }

      const total = PREGUNTAS.length;

      const elText     = document.getElementById('question-text');
      const elOpts     = document.getElementById('options-grid');
      const elFeedback = document.getElementById('feedback-msg');
      const elFeedIcon = document.getElementById('feedback-icon');
      const elFeedText = document.getElementById('feedback-text');
      const elPrev     = document.getElementById('btn-prev');
      const elNext     = document.getElementById('btn-next');
      const elSubmit   = document.getElementById('btn-submit-test');
      const elHint     = document.getElementById('answers-hint');
      const elCount    = document.getElementById('progress-count');
      const elFill     = document.getElementById('progress-fill');

      function renderPregunta(idx) {
        const p    = PREGUNTAS[idx];
        const LETRAS = ['A', 'B', 'C', 'D'];

        elText.textContent = p.pregunta;
        elOpts.innerHTML   = '';
        elFeedback.classList.remove('show', 'correct-fb', 'wrong-fb');

        // Actualizar progreso
        elCount.textContent = `${idx + 1} / ${total}`;
        const pct = ((idx) / total) * 100;
        elFill.style.width  = pct + '%';

        // Botones nav
        elPrev.disabled = idx === 0;
        const yaRespondio = respondida[p.id_pregunta];

        // Crear opciones
        p.respuestas.forEach((r, i) => {
          const btn = document.createElement('button');
          btn.className    = 'option-btn';
          btn.dataset.id   = r.id_respuesta;
          btn.disabled     = !!yaRespondio;
          btn.innerHTML = `
            <span class="option-letter">${LETRAS[i]}</span>
            <span>${r.respuesta}</span>
          `;

          // Si ya respondió esta pregunta, mostrar estado
          if (yaRespondio) {
            if (r.id_respuesta === yaRespondio.id_correcta) {
              btn.classList.add('correct');
            } else if (r.id_respuesta === respuestas[p.id_pregunta]) {
              btn.classList.add('wrong');
            }
          } else if (respuestas[p.id_pregunta] === r.id_respuesta) {
            btn.classList.add('selected');
          }

          btn.addEventListener('click', () => seleccionarRespuesta(p, r.id_respuesta, btn));
          elOpts.appendChild(btn);
        });

        // Mostrar feedback si ya respondió
        if (yaRespondio) mostrarFeedback(yaRespondio.correcta);

        // Botones siguiente/enviar
        const tieneRespuesta = respuestas[p.id_pregunta] !== undefined;
        actualizarBotones(idx, tieneRespuesta || !!yaRespondio);
      }

      function seleccionarRespuesta(pregunta, idRespuesta, btnClicado) {
        if (respondida[pregunta.id_pregunta]) return;

        // Guardar selección
        respuestas[pregunta.id_pregunta] = idRespuesta;

        // Quitar selected de todos
        elOpts.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));

        // Consultar al servidor si es correcta
        fetch(`/api/empleado/verificar-respuesta?id_respuesta=${idRespuesta}`)
          .then(r => r.json())
          .then(data => {
            const correcta = data.correcta;
            const idCorrecta = data.id_correcta;

            respondida[pregunta.id_pregunta] = { correcta, id_correcta: idCorrecta };

            // Marcar todas las opciones
            elOpts.querySelectorAll('.option-btn').forEach(btn => {
              const bid = parseInt(btn.dataset.id);
              btn.disabled = true;
              if (bid === idCorrecta) {
                btn.classList.add('correct');
              } else if (bid === idRespuesta && !correcta) {
                btn.classList.add('wrong');
              }
            });

            mostrarFeedback(correcta);
            actualizarBotones(current, true);
          })
          .catch(() => {
            // Si falla la verificación, marcar como seleccionada sin feedback
            btnClicado.classList.add('selected');
            actualizarBotones(current, true);
          });
      }

      function mostrarFeedback(correcta) {
        elFeedback.classList.remove('correct-fb', 'wrong-fb');
        if (correcta) {
          elFeedback.classList.add('show', 'correct-fb');
          elFeedIcon.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
          elFeedText.textContent = '¡Correcto! Buena respuesta.';
        } else {
          elFeedback.classList.add('show', 'wrong-fb');
          elFeedIcon.innerHTML = '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>';
          elFeedText.textContent = 'Incorrecto. La respuesta correcta está marcada en verde.';
        }
      }

      function actualizarBotones(idx, tieneRespuesta) {
        const esUltima = idx === total - 1;
        const todasRespondidas = Object.keys(respondida).length === total;

        elNext.style.display   = esUltima ? 'none' : 'inline-flex';
        elSubmit.style.display = esUltima ? 'inline-flex' : 'none';

        if (esUltima) {
          elSubmit.disabled = !todasRespondidas;
          elHint.textContent = todasRespondidas ? 'Listo para enviar' : `${total - Object.keys(respondida).length} sin responder`;
        } else {
          elNext.disabled = !tieneRespuesta;
          elHint.textContent = tieneRespuesta ? '' : 'Selecciona una opción';
        }
      }

      // Botón siguiente
      elNext.addEventListener('click', () => {
        if (current < total - 1) {
          current++;
          renderPregunta(current);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      // Botón anterior
      elPrev.addEventListener('click', () => {
        if (current > 0) {
          current--;
          renderPregunta(current);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      // Enviar test
      elSubmit.addEventListener('click', async () => {
        elSubmit.disabled = true;
        document.getElementById('sending-overlay').classList.add('show');

        const correctas   = Object.values(respondida).filter(r => r.correcta).length;
        const incorrectas = total - correctas;
        // Puntaje: porcentaje de incorrectas (mayor = más riesgo)
        const puntaje     = Math.round((incorrectas / total) * 100);

        try {
          const res  = await fetch('/api/empleado/guardar-test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ puntaje, respuestas })
          });
          const data = await res.json();

          document.getElementById('sending-overlay').classList.remove('show');

          if (res.ok && data.success) {
            mostrarResultados(puntaje, correctas, incorrectas, total);
          } else {
            alert('Error al guardar el test. Intenta de nuevo.');
            elSubmit.disabled = false;
          }
        } catch {
          document.getElementById('sending-overlay').classList.remove('show');
          alert('Error de conexión.');
          elSubmit.disabled = false;
        }
      });

      function mostrarResultados(puntaje, correctas, incorrectas, total) {
        document.getElementById('question-card').classList.add('hide');
        document.querySelector('.progress-header').style.display = 'none';
        const screen = document.getElementById('results-screen');
        screen.classList.add('show');

        // Animar ring
        const ring   = document.getElementById('ring-fill');
        const offset = 376 - (puntaje / 100) * 376;
        setTimeout(() => { ring.style.strokeDashoffset = offset; }, 100);

        // Color según puntaje (puntaje alto = más riesgo)
        const color = puntaje >= 75 ? '#ff4d6a'
          : puntaje >= 50 ? '#ff8099'
          : puntaje >= 25 ? '#ffb347' : '#00e5a0';

        ring.style.stroke = color;

        const nivel = puntaje >= 75 ? 'Riesgo Crítico'
          : puntaje >= 50 ? 'Riesgo Alto'
          : puntaje >= 25 ? 'Riesgo Medio' : 'Riesgo Bajo';

        const desc = puntaje >= 75
          ? 'Tu nivel de vulnerabilidad es muy alto. Se recomienda capacitación urgente en ciberseguridad.'
          : puntaje >= 50
          ? 'Tienes áreas importantes de mejora. Revisa las recomendaciones de tu empresa.'
          : puntaje >= 25
          ? 'Buen nivel general, pero hay puntos que fortalecer.'
          : '¡Excelente! Demuestras buenos hábitos de seguridad digital.';

        document.getElementById('res-score').textContent     = puntaje;
        document.getElementById('res-score').style.color     = color;
        document.getElementById('res-nivel').textContent     = nivel;
        document.getElementById('res-nivel').style.color     = color;
        document.getElementById('res-desc').textContent      = desc;
        document.getElementById('res-correctas').textContent = correctas;
        document.getElementById('res-incorrectas').textContent = incorrectas;
        document.getElementById('res-total').textContent     = total;

        // Actualizar progreso a 100%
        elFill.style.width = '100%';
        elCount.textContent = `${total} / ${total}`;
      }

      // Render inicial
      renderPregunta(0);
    }
  </script>
</body>
</html>